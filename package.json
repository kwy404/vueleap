{
  "name": "vueleap",
  "version": "1.0.0",
  "description": "Find what breaks when a Vue 2 app moves to Vue 3, apply the safe fixes and get the @vue/compat flags it needs.",
  "keywords": [
    "vue",
    "vue2",
    "vue3",
    "migration",
    "codemod",
    "vue-compat",
    "static-analysis",
    "cli"
  ],
  "homepage": "https://kwy404.github.io/vueleap/",
  "bugs": {
    "url": "https://github.com/kwy404/vueleap/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwy404/vueleap.git"
  },
  "license": "MIT",
  "author": "Alexandre Kohler (https://github.com/kwy404)",
  "type": "module",
  "bin": {
    "vueleap": "dist/bin.js",
    "vue2to3": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:update": "vitest run -u",
    "prepublishOnly": "npm run build && npm test",
    "docs:build": "npm run build && node scripts/render-assets.mjs && node scripts/build-live.mjs && node scripts/build-docs.mjs && node scripts/highlight-docs.mjs",
    "docs:png": "bash scripts/render-png.sh",
    "docs:highlight": "node scripts/highlight-docs.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:live": "node scripts/build-live.mjs",
    "docs:seasons": "node scripts/season-art.mjs"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/types": "^7.29.8",
    "@vue/compiler-dom": "^3.5.43",
    "@vue/compiler-sfc": "^3.5.43",
    "diff": "^8.0.4",
    "ignore": "^7.0.12",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^18.19.130",
    "@vue/compat": "^3.5.43",
    "eslint": "^9.39.5",
    "shiki": "~3.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "~8.55.0",
    "vite": "^6.4.4",
    "vitest": "^3.2.7",
    "vue": "^3.5.43"
  }
}
